ARG NODE_IMAGE=node:24-bookworm-slim
FROM ${NODE_IMAGE} AS builder
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1 NODE_OPTIONS=--max-old-space-size=1100
RUN npm install --global pnpm@10.33.0
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile --ignore-scripts
COPY . .
ARG NEXT_PUBLIC_APP_URL=http://localhost:3101
ENV STORYBLOOM_STANDALONE=1 NEXT_PUBLIC_APP_URL=${NEXT_PUBLIC_APP_URL}
RUN pnpm build

FROM ${NODE_IMAGE} AS runner
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 HOSTNAME=0.0.0.0 PORT=3101 STORYBLOOM_LOCAL_DATA_DIR=/data
COPY --from=builder --chown=node:node /app/.next/standalone ./
COPY --from=builder --chown=node:node /app/.next/static ./.next/static
COPY --from=builder --chown=node:node /app/public ./public
USER node
EXPOSE 3101
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 CMD node -e "const r=require('node:http').get({hostname:'127.0.0.1',port:process.env.PORT||3101,path:'/api/local/auth/session',headers:{Host:new URL(process.env.STORYBLOOM_WORKBENCH_ORIGIN||'http://localhost:3101').host}},s=>{s.resume();s.on('end',()=>process.exit(s.statusCode===200?0:1))});r.on('error',()=>process.exit(1));r.setTimeout(8000,()=>{r.destroy();process.exit(1)})"
CMD ["node","server.js"]
